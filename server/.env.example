OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Wake word: any name bundled with openWakeWord (hey_jarvis, alexa, hey_mycroft, ...)
WAKE_WORDS=hey_jarvis
WAKE_THRESHOLD=0.5

# Speech recognition
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Text to speech
PIPER_VOICE=models/piper/en_US-lessac-medium.onnx

# Turn taking
VAD_AGGRESSIVENESS=2
END_SILENCE_MS=900
MAX_UTTERANCE_MS=15000
NO_SPEECH_TIMEOUT_MS=6000

# Conversation
HISTORY_TURNS=8
MAX_REPLY_TOKENS=350
# Nemotron spends its whole budget on a reasoning preamble unless this is false
DISABLE_REASONING=true

# Optional shared secret. If set, clients must connect with ?token=...
ASSIST_TOKEN=

HOST=0.0.0.0
PORT=8765
LOG_LEVEL=INFO
