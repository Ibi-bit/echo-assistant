OPENROUTER_API_KEY=
# Primary model. Cheap paid models are far better at tool calls than the free ones.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Comma-separated backups, tried in order if the primary fails before replying.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free

# Wake word: any name bundled with openWakeWord (hey_jarvis, alexa, hey_mycroft, ...)
WAKE_WORDS=hey_jarvis
WAKE_THRESHOLD=0.5

# Speech recognition
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Text to speech
PIPER_VOICE=models/piper/en_US-lessac-medium.onnx

# Turn taking
VAD_AGGRESSIVENESS=2
END_SILENCE_MS=900
MAX_UTTERANCE_MS=15000
NO_SPEECH_TIMEOUT_MS=6000

# Conversation
HISTORY_TURNS=8
MAX_REPLY_TOKENS=350
# Some models (Nemotron) spend their whole budget on a reasoning preamble unless this is false
DISABLE_REASONING=true
# Optional city used when you ask about the weather
ASSIST_LOCATION=
# Leave empty to use the built-in spoken-style prompt
SYSTEM_PROMPT=

# Optional shared token. When set, clients send it as an Authorization: Bearer
# header (or ?token=...); it also protects the web config.
# Without it, only local/private-network clients are accepted.
ASSIST_TOKEN=

HOST=0.0.0.0
PORT=8765
LOG_LEVEL=INFO
