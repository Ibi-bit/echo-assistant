<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/setup_card"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Echo Show Assistant"
        android:textColor="#7DD3FC"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Rusty keeps the screen. This app only draws a small floating card over it."
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Checking permissions…"
        android:textColor="#E2E8F0"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0.7"
        android:text="Relay WebSocket"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/relay_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#7DD3FC"
        android:inputType="textUri"
        android:singleLine="true"
        android:textColor="#E2E8F0"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <Button
        android:id="@+id/overlay_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Allow display over other apps" />

    <Button
        android:id="@+id/mic_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow microphone" />

    <Button
        android:id="@+id/access_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow now-playing access" />

    <TextView
        android:id="@+id/access_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Optional. Lets the assistant see the track Rusty is showing and press its playback buttons."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0.7"
        android:text="Type a request (testing — no wake word needed)"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/test_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#7DD3FC"
        android:hint="e.g. set a timer for one minute"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="#E2E8F0"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <Button
        android:id="@+id/send_text_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send to assistant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/start_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start assistant" />

        <Button
            android:id="@+id/stop_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0.6"
        android:text="Tap the floating card to talk. Long-press it to reopen this dialog."
        android:textColor="#94A3B8"
        android:textSize="12sp" />
</LinearLayout>
